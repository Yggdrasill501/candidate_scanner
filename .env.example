# Matches the Postgres service in docker-compose.yml (host port 5435).
DATABASE_URL=postgres://postgres:postgres@localhost:5435/koho_volim

# Separate database holding the Slovensko.Digital RPO dump (pipeline only)
EKOSYSTEM_URL=postgres://postgres:postgres@localhost:5435/ekosystem

# Contact for Wikimedia API user-agent (their policy asks for one); used only for wikipedia requests
WIKIMEDIA_CONTACT=

# Neon (production). `neon deploy` writes DATABASE_URL / DATABASE_URL_UNPOOLED here; keep the local
# DATABASE_URL above and store Neon's under these names. Vercel's DATABASE_URL is the pooled one;
# use the unpooled (direct) one for migrations and pg_dump/pg_restore.
NEON_DATABASE_URL=
NEON_DATABASE_URL_UNPOOLED=
NEON_BRANCH=
